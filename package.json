{
  "name": "project-wizard",
  "displayName": "Project Wizard",
  "description": "Create CLI, desktop, mobile, web, and game projects with local toolchain detection and custom ZIP templates.",
  "version": "0.9.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/GrahamCHill/Project-Wizard.git"
  },
  "publisher": "project-wizard-local",
  "private": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Project Wizard runs locally installed project generators."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "projectWizard.newProject",
        "title": "New Project",
        "category": "Project Wizard"
      },
      {
        "command": "projectWizard.newProjectInWorkspace",
        "title": "New Project in Workspace…",
        "category": "Project Wizard"
      },
      {
        "command": "projectWizard.chooseZipDirectory",
        "title": "Choose ZIP Templates Folder",
        "category": "Project Wizard"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "projectWizard.newProject",
          "when": "explorerResourceIsFolder",
          "group": "navigation@30"
        }
      ]
    },
    "configuration": {
      "title": "Project Wizard",
      "properties": {
        "projectWizard.zipTemplatesDirectory": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the folder containing .zip project templates."
        },
        "projectWizard.catalog": {
          "type": "object",
          "scope": "application",
          "description": "Configure Project Wizard startup and template visibility.",
          "default": {
            "disabledLanguages": [],
            "disabledTemplates": [],
            "enableVrTemplates": false,
            "enableLatexTemplates": false,
            "openOnStartup": false
          },
          "additionalProperties": false,
          "properties": {
            "disabledLanguages": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Language names hidden in the catalog."
            },
            "disabledTemplates": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Template IDs hidden in the catalog."
            },
            "enableVrTemplates": {
              "type": "boolean",
              "description": "Show the optional VR template set."
            },
            "enableLatexTemplates": {
              "type": "boolean",
              "description": "Show the optional LaTeX templates."
            },
            "openOnStartup": {
              "type": "boolean",
              "description": "Open Project Wizard when VS Code starts."
            }
          }
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "package": "vsce package"
  },
  "dependencies": {
    "@img/sharp-wasm32": "0.35.5",
    "buffer-crc32": "0.2.13",
    "sharp": "0.35.5",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.0",
    "yazl": "2.5.1"
  }
}
