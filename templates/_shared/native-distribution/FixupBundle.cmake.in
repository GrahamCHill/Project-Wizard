include(BundleUtilities)

function(gp_item_default_embedded_path_override item destination)
    if(item MATCHES "[.]dylib$" AND NOT item MATCHES "[.]framework/")
        set(${destination} "@executable_path/../Frameworks" PARENT_SCOPE)
    endif()
endfunction()

set(bundle "${CMAKE_INSTALL_PREFIX}/$<TARGET_BUNDLE_DIR_NAME:@distribution_target@>")
set(plugins)
get_item_rpaths("$<TARGET_FILE:@distribution_target@>" build_rpaths)
set(search_dirs "$<TARGET_FILE_DIR:@distribution_target@>" ${build_rpaths})
if(@distribution_vulkan@)
    set(moltenvk "@PROJECT_MOLTENVK_LIBRARY@")
    set(icd "@PROJECT_MOLTENVK_ICD@")
    if(NOT EXISTS "${moltenvk}" OR NOT EXISTS "${icd}")
        message(FATAL_ERROR "Install the Vulkan SDK with MoltenVK and reconfigure before packaging.")
    endif()
    file(REAL_PATH "${moltenvk}" moltenvk_binary)
    file(INSTALL DESTINATION "${bundle}/Contents/Frameworks" TYPE FILE RENAME libMoltenVK.dylib FILES "${moltenvk_binary}")
    list(APPEND plugins "${bundle}/Contents/Frameworks/libMoltenVK.dylib")
    get_filename_component(sdk_lib_dir "${moltenvk}" DIRECTORY)
    list(APPEND search_dirs "${sdk_lib_dir}" "@vulkan_lib_dir@")

    file(READ "${icd}" manifest)
    string(JSON manifest SET "${manifest}" ICD library_path "\"../../../Frameworks/libMoltenVK.dylib\"")
    set(icd_dir "${bundle}/Contents/Resources/vulkan/icd.d")
    file(MAKE_DIRECTORY "${icd_dir}")
    file(WRITE "${icd_dir}/MoltenVK_icd.json" "${manifest}\n")
endif()
set(BU_CHMOD_BUNDLE_ITEMS ON)
fixup_bundle("${bundle}" "${plugins}" "${search_dirs}")
execute_process(COMMAND /usr/bin/codesign --force --deep --sign - "${bundle}" COMMAND_ERROR_IS_FATAL ANY)
