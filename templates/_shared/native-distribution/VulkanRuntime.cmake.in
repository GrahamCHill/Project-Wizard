set(runtime "@PROJECT_VULKAN_RUNTIME_DIR@")
set(license "${runtime}/VulkanRT-License.txt")
if(NOT runtime)
    if("@vulkan_arch@" STREQUAL "arm64")
        message(FATAL_ERROR "Set PROJECT_VULKAN_RUNTIME_DIR to the ARM64 Vulkan redistributable loader directory.")
    endif()
    set(cache_dir "@CMAKE_CURRENT_BINARY_DIR@/vulkan-runtime")
    set(archive "${cache_dir}/VulkanRT-X64-1.4.363.0-Components.zip")
    file(MAKE_DIRECTORY "${cache_dir}")
    file(DOWNLOAD "https://sdk.lunarg.com/sdk/download/1.4.363.0/windows/vulkan-runtime-components.zip" "${archive}"
        EXPECTED_HASH SHA256=a25a927aa8b9f0371048f1861cf88ac3b9bc9b1fb332c42d897c8ab32695769a
        TLS_VERIFY ON TIMEOUT 120)
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${cache_dir}")
    set(runtime_root "${cache_dir}/VulkanRT-X64-1.4.363.0-Components")
    set(runtime "${runtime_root}/@vulkan_arch@")
    set(license "${runtime_root}/VulkanRT-License.txt")
endif()
file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}" TYPE FILE FILES "${runtime}/vulkan-1.dll")
file(INSTALL DESTINATION "${CMAKE_INSTALL_PREFIX}/licenses/vulkan" TYPE FILE FILES "${license}")
