# Convert a GLSL source or a compiled SPIR-V module to a C/C++ header.
if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT OR NOT SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "Pass INPUT, OUTPUT, SYMBOL, and MODE (TEXT or SPIRV).")
endif()
file(READ "${INPUT}" shader HEX)
if(MODE STREQUAL "SPIRV")
    string(LENGTH "${shader}" length)
    math(EXPR remainder "${length} % 8")
    if(NOT remainder EQUAL 0 OR NOT shader MATCHES "^03022307")
        message(FATAL_ERROR "${INPUT} is not a little-endian SPIR-V module.")
    endif()
    # Emit 32-bit words, so pCode has the alignment required by Vulkan.
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u,\n" shader "${shader}")
    set(source "#include <stdint.h>\nstatic const uint32_t ${SYMBOL}[] = {\n${shader}};\n")
elseif(MODE STREQUAL "TEXT")
    string(REGEX REPLACE "(..)" "0x\\1," shader "${shader}")
    set(source "static const unsigned char ${SYMBOL}[] = {${shader}0x00};\n")
else()
    message(FATAL_ERROR "Unknown shader embedding mode: ${MODE}")
endif()
file(WRITE "${OUTPUT}" "${source}")
