terraform {
  required_version = ">= 1.9"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 4.30"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }
}

provider "azurerm" {
  # When null, the provider reads ARM_SUBSCRIPTION_ID or the Azure CLI's active subscription.
  subscription_id = var.subscription_id

  features {}
}
